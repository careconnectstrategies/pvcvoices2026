# Copy this file to .env.local for local development, and add the same
# two values in Vercel → Project Settings → Environment Variables.
#
# Find both in your Supabase project: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# The site's final public URL, used for sitemap.xml, robots.txt, and social
# share previews (Open Graph / Twitter cards). Set this once you know your
# production domain (a vercel.app URL or a custom domain). Safe to leave
# unset for now — Vercel deployments fall back to their own preview URL.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com
